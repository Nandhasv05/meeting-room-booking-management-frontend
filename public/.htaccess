RewriteEngine On
RewriteBase /Meeting/

# PHP-FPM/CGI drop Authorization unless it is copied into the environment.
CGIPassAuth On
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Forward API to Node via PHP if Apache ProxyPass is not enabled
RewriteRule ^api(?:/(.*))?$ api-proxy.php?mh_path=$1 [QSA,L]
RewriteRule ^uploads(?:/(.*))?$ - [L]
RewriteRule ^socket\.io(/|$) - [L]
RewriteRule ^assets(?:/(.*))?$ - [L]
RewriteRule ^api-proxy\.php$ - [L]

RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /Meeting/index.html [L]
